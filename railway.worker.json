{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "worker.Dockerfile",
    "watchPatterns": [
      "ai/**",
      "core/**",
      "utils/**",
      "worker/**",
      "requirements.txt",
      "requirements-worker.txt",
      "worker.Dockerfile",
      "README.md"
    ]
  },
  "deploy": {
    "startCommand": "python worker/main.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
